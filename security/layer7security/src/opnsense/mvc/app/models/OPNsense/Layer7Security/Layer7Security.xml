<model>
    <mount>//OPNsense/layer7security</mount>
    <version>1.4.0</version>
    <description>Layer 7 Security: application visibility, policies and DNS filtering</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <interfaces type="InterfaceField">
                <Required>N</Required>
                <multiple>Y</multiple>
                <AllowDynamic>Y</AllowDynamic>
            </interfaces>
            <enforce type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </enforce>
            <retention type="IntegerField">
                <Default>7</Default>
                <Required>Y</Required>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>365</MaximumValue>
                <ValidationMessage>Retention must be between 1 and 365 days.</ValidationMessage>
            </retention>
            <flowTimeout type="IntegerField">
                <Default>60</Default>
                <Required>Y</Required>
                <MinimumValue>10</MinimumValue>
                <MaximumValue>600</MaximumValue>
                <ValidationMessage>Flow timeout must be between 10 and 600 seconds.</ValidationMessage>
            </flowTimeout>
            <blockTtl type="IntegerField">
                <Default>3600</Default>
                <Required>Y</Required>
                <MinimumValue>60</MinimumValue>
                <MaximumValue>86400</MaximumValue>
                <ValidationMessage>Block lifetime must be between 60 and 86400 seconds.</ValidationMessage>
            </blockTtl>
            <dnsFilter type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </dnsFilter>
            <dnsMode type="OptionField">
                <Default>nxdomain</Default>
                <Required>Y</Required>
                <OptionValues>
                    <nxdomain>NXDOMAIN (name does not exist)</nxdomain>
                    <refuse>REFUSED</refuse>
                    <null>Sinkhole (0.0.0.0 / ::)</null>
                </OptionValues>
            </dnsMode>
            <dnsCategories type="OptionField">
                <Required>N</Required>
                <multiple>Y</multiple>
                <OptionValues>
                    <ads>Advertising</ads>
                    <trackers>Trackers</trackers>
                    <malware>Malware</malware>
                    <phishing>Phishing</phishing>
                    <adult>Adult content</adult>
                    <gambling>Gambling</gambling>
                    <social>Social networks</social>
                    <streaming>Streaming media</streaming>
                    <games>Games</games>
                </OptionValues>
            </dnsCategories>
            <dnsBlock type="CSVListField">
                <Required>N</Required>
                <MaskPerItem>Y</MaskPerItem>
                <Mask>/^[a-z0-9]([a-z0-9._-]{0,251}[a-z0-9])?$/i</Mask>
                <ValidationMessage>Enter domain names such as example.com, separated by commas.</ValidationMessage>
            </dnsBlock>
            <dnsAllow type="CSVListField">
                <Required>N</Required>
                <MaskPerItem>Y</MaskPerItem>
                <Mask>/^[a-z0-9]([a-z0-9._-]{0,251}[a-z0-9])?$/i</Mask>
                <ValidationMessage>Enter domain names such as example.com, separated by commas.</ValidationMessage>
            </dnsAllow>
            <feedUrl type="TextField">
                <Required>N</Required>
                <Mask>/^https?:\/\/[A-Za-z0-9.:\/_-]{1,200}$/</Mask>
                <ValidationMessage>Enter an http(s) URL without spaces, for example http://192.168.1.73:8080/feeds</ValidationMessage>
            </feedUrl>
            <macMode type="OptionField">
                <Default>off</Default>
                <Required>Y</Required>
                <OptionValues>
                    <off>Off</off>
                    <protect>Protect bound addresses (an IP may only be used by its MAC)</protect>
                    <strict>Strict (additionally block every unknown device)</strict>
                </OptionValues>
            </macMode>
            <macInterfaces type="InterfaceField">
                <Required>N</Required>
                <multiple>Y</multiple>
                <AllowDynamic>Y</AllowDynamic>
            </macInterfaces>
            <macStaticArp type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </macStaticArp>
            <geoEnabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </geoEnabled>
            <geoSource type="TextField">
                <Required>N</Required>
                <Mask>/^https?:\/\/[A-Za-z0-9.:\/_-]{1,200}$/</Mask>
                <ValidationMessage>Enter an http(s) base URL that serves ip2country-v4.tsv.gz and ip2country-v6.tsv.gz, or leave empty for iptoasn.com.</ValidationMessage>
            </geoSource>
            <aiEnabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </aiEnabled>
            <aiDefault type="OptionField">
                <Default>monitor</Default>
                <Required>Y</Required>
                <OptionValues>
                    <allow>Allow (tag and count only)</allow>
                    <monitor>Monitor (tag, count and log)</monitor>
                    <block>Block</block>
                </OptionValues>
            </aiDefault>
            <aiQuic type="OptionField">
                <Default>off</Default>
                <Required>Y</Required>
                <OptionValues>
                    <off>Do not touch QUIC</off>
                    <ai>Block QUIC (UDP 443) to AI services</ai>
                    <all>Block all QUIC (UDP 443)</all>
                </OptionValues>
            </aiQuic>
        </general>
        <ai>
            <service type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <service type=".\AiServiceField">
                    <Required>Y</Required>
                </service>
                <action type="OptionField">
                    <Default>monitor</Default>
                    <Required>Y</Required>
                    <OptionValues>
                        <allow>Allow (tag and count only)</allow>
                        <monitor>Monitor (tag, count and log)</monitor>
                        <block>Block</block>
                    </OptionValues>
                </action>
                <inspect type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </inspect>
                <sources type="NetworkField">
                    <Required>N</Required>
                    <asList>Y</asList>
                    <WildcardEnabled>N</WildcardEnabled>
                    <ValidationMessage>Enter IP addresses or networks (CIDR), separated by commas.</ValidationMessage>
                </sources>
                <users type="ModelRelationField">
                    <Model>
                        <user>
                            <source>OPNsense.Layer7Security.Layer7Security</source>
                            <items>users.user</items>
                            <display>name</display>
                        </user>
                    </Model>
                    <Required>N</Required>
                    <multiple>Y</multiple>
                </users>
                <days type="OptionField">
                    <Default>sun,mon,tue,wed,thu,fri,sat</Default>
                    <Required>Y</Required>
                    <multiple>Y</multiple>
                    <OptionValues>
                        <mon>Monday</mon>
                        <tue>Tuesday</tue>
                        <wed>Wednesday</wed>
                        <thu>Thursday</thu>
                        <fri>Friday</fri>
                        <sat>Saturday</sat>
                        <sun>Sunday</sun>
                    </OptionValues>
                </days>
                <startTime type="TextField">
                    <Default>00:00</Default>
                    <Required>Y</Required>
                    <Mask>/^([01]?[0-9]|2[0-3]):[0-5][0-9]$/</Mask>
                    <ValidationMessage>Enter a time as HH:MM (24 hour).</ValidationMessage>
                </startTime>
                <endTime type="TextField">
                    <Default>00:00</Default>
                    <Required>Y</Required>
                    <Mask>/^([01]?[0-9]|2[0-3]):[0-5][0-9]$/</Mask>
                    <ValidationMessage>Enter a time as HH:MM (24 hour).</ValidationMessage>
                </endTime>
                <description type="DescriptionField"/>
            </service>
        </ai>
        <bindings>
            <binding type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <name type="TextField">
                    <Required>Y</Required>
                    <Mask>/^[A-Za-z0-9_.@ -]{1,64}$/</Mask>
                    <ValidationMessage>Use 1-64 letters, digits, space, dot, dash, underscore or @.</ValidationMessage>
                </name>
                <mac type="MacAddressField">
                    <Required>Y</Required>
                </mac>
                <ip type="TextField">
                    <Required>N</Required>
                    <Mask>/^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])$/</Mask>
                    <ValidationMessage>Enter one IPv4 address, or leave empty to bind the MAC only.</ValidationMessage>
                </ip>
                <interface type="InterfaceField">
                    <Required>N</Required>
                    <AllowDynamic>Y</AllowDynamic>
                </interface>
                <description type="DescriptionField"/>
            </binding>
        </bindings>
        <geo>
            <policy type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <name type="TextField">
                    <Required>Y</Required>
                    <Mask>/^[A-Za-z0-9_.@ -]{1,64}$/</Mask>
                    <ValidationMessage>Use 1-64 letters, digits, space, dot, dash, underscore or @.</ValidationMessage>
                </name>
                <action type="OptionField">
                    <Default>block</Default>
                    <Required>Y</Required>
                    <OptionValues>
                        <block>Block the selected countries</block>
                        <allow>Allow only the selected countries</allow>
                    </OptionValues>
                </action>
                <direction type="OptionField">
                    <Default>in</Default>
                    <Required>Y</Required>
                    <OptionValues>
                        <in>Inbound (traffic coming from the country)</in>
                        <out>Outbound (traffic going to the country)</out>
                        <both>Both directions</both>
                    </OptionValues>
                </direction>
                <interfaces type="InterfaceField">
                    <Required>N</Required>
                    <multiple>Y</multiple>
                    <AllowDynamic>Y</AllowDynamic>
                </interfaces>
                <countries type="CountryField">
                    <Required>Y</Required>
                    <multiple>Y</multiple>
                </countries>
                <exceptions type="NetworkField">
                    <Required>N</Required>
                    <asList>Y</asList>
                    <WildcardEnabled>N</WildcardEnabled>
                    <ValidationMessage>Enter IP addresses or networks (CIDR), separated by commas.</ValidationMessage>
                </exceptions>
                <log type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </log>
                <description type="DescriptionField"/>
            </policy>
        </geo>
        <dlp>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <inspectDefault type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </inspectDefault>
            <cardAction type="OptionField">
                <Default>block</Default>
                <Required>Y</Required>
                <OptionValues>
                    <off>Off</off>
                    <monitor>Detect and log only</monitor>
                    <block>Block the request</block>
                </OptionValues>
            </cardAction>
            <idAction type="OptionField">
                <Default>block</Default>
                <Required>Y</Required>
                <OptionValues>
                    <off>Off</off>
                    <monitor>Detect and log only</monitor>
                    <block>Block the request</block>
                </OptionValues>
            </idAction>
            <keyAction type="OptionField">
                <Default>block</Default>
                <Required>Y</Required>
                <OptionValues>
                    <off>Off</off>
                    <monitor>Detect and log only</monitor>
                    <block>Block the request</block>
                </OptionValues>
            </keyAction>
            <codeAction type="OptionField">
                <Default>monitor</Default>
                <Required>Y</Required>
                <OptionValues>
                    <off>Off</off>
                    <monitor>Detect and log only</monitor>
                    <block>Block the request</block>
                </OptionValues>
            </codeAction>
            <codeMinLines type="IntegerField">
                <Default>12</Default>
                <Required>Y</Required>
                <MinimumValue>5</MinimumValue>
                <MaximumValue>500</MaximumValue>
                <ValidationMessage>Enter a number of lines between 5 and 500.</ValidationMessage>
            </codeMinLines>
            <failMode type="OptionField">
                <Default>closed</Default>
                <Required>Y</Required>
                <OptionValues>
                    <closed>Fail closed (requests to inspected services fail if the scanner is down)</closed>
                    <open>Fail open (requests pass uninspected if the scanner is down)</open>
                </OptionValues>
            </failMode>
            <maxBodyKb type="IntegerField">
                <Default>4096</Default>
                <Required>Y</Required>
                <MinimumValue>16</MinimumValue>
                <MaximumValue>16384</MaximumValue>
                <ValidationMessage>Enter a size between 16 and 16384 KB.</ValidationMessage>
            </maxBodyKb>
            <blockMessage type="TextField">
                <Required>N</Required>
                <Mask>/^[^&lt;&gt;]{0,500}$/s</Mask>
                <ValidationMessage>The message may not contain angle brackets and is limited to 500 characters. {what} is replaced by the kind of data found.</ValidationMessage>
            </blockMessage>
        </dlp>
        <av>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <scanHttp type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </scanHttp>
            <httpsDomains type="CSVListField">
                <Required>N</Required>
                <MaskPerItem>Y</MaskPerItem>
                <Mask>/^[a-z0-9]([a-z0-9._-]{0,251}[a-z0-9])?$/i</Mask>
                <ValidationMessage>Enter domain names such as downloads.example.com, separated by commas.</ValidationMessage>
            </httpsDomains>
            <skipDomains type="CSVListField">
                <Required>N</Required>
                <MaskPerItem>Y</MaskPerItem>
                <Mask>/^[a-z0-9]([a-z0-9._-]{0,251}[a-z0-9])?$/i</Mask>
                <ValidationMessage>Enter domain names such as example.com, separated by commas.</ValidationMessage>
            </skipDomains>
            <maxSizeMb type="IntegerField">
                <Default>50</Default>
                <Required>Y</Required>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>200</MaximumValue>
                <ValidationMessage>Enter a size between 1 and 200 MB.</ValidationMessage>
            </maxSizeMb>
            <hashAction type="OptionField">
                <Default>block</Default>
                <Required>Y</Required>
                <OptionValues>
                    <off>Allow, do not look</off>
                    <monitor>Detect and log only</monitor>
                    <block>Block the download</block>
                </OptionValues>
            </hashAction>
            <executableAction type="OptionField">
                <Default>monitor</Default>
                <Required>Y</Required>
                <OptionValues>
                    <off>Allow, do not look</off>
                    <monitor>Detect and log only</monitor>
                    <block>Block the download</block>
                </OptionValues>
            </executableAction>
            <scriptAction type="OptionField">
                <Default>monitor</Default>
                <Required>Y</Required>
                <OptionValues>
                    <off>Allow, do not look</off>
                    <monitor>Detect and log only</monitor>
                    <block>Block the download</block>
                </OptionValues>
            </scriptAction>
            <packageAction type="OptionField">
                <Default>monitor</Default>
                <Required>Y</Required>
                <OptionValues>
                    <off>Allow, do not look</off>
                    <monitor>Detect and log only</monitor>
                    <block>Block the download</block>
                </OptionValues>
            </packageAction>
            <archiveAction type="OptionField">
                <Default>off</Default>
                <Required>Y</Required>
                <OptionValues>
                    <off>Allow, do not look</off>
                    <monitor>Detect and log only</monitor>
                    <block>Block the download</block>
                </OptionValues>
            </archiveAction>
            <customHashes type="CSVListField">
                <Required>N</Required>
                <MaskPerItem>Y</MaskPerItem>
                <Mask>/^[0-9a-fA-F]{64}$/</Mask>
                <ValidationMessage>Enter SHA-256 hashes (64 hexadecimal characters), separated by commas.</ValidationMessage>
            </customHashes>
            <feedUrl type="TextField">
                <Required>N</Required>
                <Mask>/^https?:\/\/[^\s"'&lt;&gt;]{1,500}$/</Mask>
                <ValidationMessage>Enter a http:// or https:// address.</ValidationMessage>
            </feedUrl>
            <feedAuthKey type="TextField">
                <Required>N</Required>
                <Mask>/^[A-Za-z0-9._~+\/=-]{0,200}$/</Mask>
                <ValidationMessage>The key may only contain letters, digits and . _ ~ + / = -</ValidationMessage>
            </feedAuthKey>
            <feedHours type="IntegerField">
                <Default>24</Default>
                <Required>Y</Required>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>168</MaximumValue>
                <ValidationMessage>Enter between 1 and 168 hours.</ValidationMessage>
            </feedHours>
            <failMode type="OptionField">
                <Default>open</Default>
                <Required>Y</Required>
                <OptionValues>
                    <open>Fail open (downloads pass unscanned if the scanner is down)</open>
                    <closed>Fail closed (downloads fail if the scanner is down)</closed>
                </OptionValues>
            </failMode>
        </av>
        <audit>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <retentionDays type="IntegerField">
                <Default>365</Default>
                <Required>Y</Required>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>3650</MaximumValue>
                <ValidationMessage>Retention must be between 1 and 3650 days.</ValidationMessage>
            </retentionDays>
            <syslogLocal type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </syslogLocal>
            <syslogTarget type="TextField">
                <Required>N</Required>
                <Mask>/^[A-Za-z0-9.-]{1,200}(:[0-9]{1,5})?$/</Mask>
                <ValidationMessage>Enter a host name or address with an optional port, for example 192.168.1.50:514.</ValidationMessage>
            </syslogTarget>
            <noticeText type="TextField">
                <Required>N</Required>
                <Mask>/^[^&lt;&gt;]{0,2000}$/s</Mask>
                <ValidationMessage>The notice may not contain angle brackets and is limited to 2000 characters.</ValidationMessage>
            </noticeText>
            <privacyAckBy type="TextField">
                <Required>N</Required>
            </privacyAckBy>
            <privacyAckAt type="TextField">
                <Required>N</Required>
            </privacyAckAt>
        </audit>
        <users>
            <user type="ArrayField">
                <name type="TextField">
                    <Required>Y</Required>
                    <Mask>/^[A-Za-z0-9_.@ -]{1,64}$/</Mask>
                    <ValidationMessage>Use 1-64 letters, digits, space, dot, dash, underscore or @.</ValidationMessage>
                    <Constraints>
                        <check001>
                            <ValidationMessage>A user with this name already exists.</ValidationMessage>
                            <type>UniqueConstraint</type>
                        </check001>
                    </Constraints>
                </name>
                <addresses type="NetworkField">
                    <Required>Y</Required>
                    <asList>Y</asList>
                    <WildcardEnabled>N</WildcardEnabled>
                    <ValidationMessage>Enter IP addresses or networks (CIDR), separated by commas.</ValidationMessage>
                </addresses>
                <description type="DescriptionField"/>
            </user>
        </users>
        <policies>
            <policy type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <name type="TextField">
                    <Required>Y</Required>
                    <Mask>/^[A-Za-z0-9_.@ -]{1,64}$/</Mask>
                    <ValidationMessage>Use 1-64 letters, digits, space, dot, dash, underscore or @.</ValidationMessage>
                </name>
                <sequence type="IntegerField">
                    <Default>100</Default>
                    <Required>Y</Required>
                    <MinimumValue>1</MinimumValue>
                    <MaximumValue>9999</MaximumValue>
                    <ValidationMessage>Sequence must be between 1 and 9999; lower runs first.</ValidationMessage>
                </sequence>
                <action type="OptionField">
                    <Default>block</Default>
                    <Required>Y</Required>
                    <OptionValues>
                        <monitor>Monitor (log only)</monitor>
                        <allow>Allow (exempt from later policies)</allow>
                        <block>Block</block>
                    </OptionValues>
                </action>
                <interfaces type="InterfaceField">
                    <Required>N</Required>
                    <multiple>Y</multiple>
                    <AllowDynamic>Y</AllowDynamic>
                </interfaces>
                <sources type="NetworkField">
                    <Required>N</Required>
                    <asList>Y</asList>
                    <WildcardEnabled>N</WildcardEnabled>
                    <ValidationMessage>Enter IP addresses or networks (CIDR), separated by commas.</ValidationMessage>
                </sources>
                <users type="ModelRelationField">
                    <Model>
                        <user>
                            <source>OPNsense.Layer7Security.Layer7Security</source>
                            <items>users.user</items>
                            <display>name</display>
                        </user>
                    </Model>
                    <Required>N</Required>
                    <multiple>Y</multiple>
                </users>
                <applications type=".\AppField">
                    <Required>N</Required>
                    <multiple>Y</multiple>
                </applications>
                <categories type=".\CategoryField">
                    <Required>N</Required>
                    <multiple>Y</multiple>
                </categories>
                <hosts type="CSVListField">
                    <Required>N</Required>
                    <MaskPerItem>Y</MaskPerItem>
                    <Mask>/^[a-z0-9]([a-z0-9._-]{0,251}[a-z0-9])?$/i</Mask>
                    <ValidationMessage>Enter domain names such as example.com, separated by commas.</ValidationMessage>
                </hosts>
                <days type="OptionField">
                    <Default>sun,mon,tue,wed,thu,fri,sat</Default>
                    <Required>Y</Required>
                    <multiple>Y</multiple>
                    <OptionValues>
                        <mon>Monday</mon>
                        <tue>Tuesday</tue>
                        <wed>Wednesday</wed>
                        <thu>Thursday</thu>
                        <fri>Friday</fri>
                        <sat>Saturday</sat>
                        <sun>Sunday</sun>
                    </OptionValues>
                </days>
                <startTime type="TextField">
                    <Default>00:00</Default>
                    <Required>Y</Required>
                    <Mask>/^([01]?[0-9]|2[0-3]):[0-5][0-9]$/</Mask>
                    <ValidationMessage>Enter a time as HH:MM (24 hour).</ValidationMessage>
                </startTime>
                <endTime type="TextField">
                    <Default>00:00</Default>
                    <Required>Y</Required>
                    <Mask>/^([01]?[0-9]|2[0-3]):[0-5][0-9]$/</Mask>
                    <ValidationMessage>Enter a time as HH:MM (24 hour).</ValidationMessage>
                </endTime>
                <dnsCategories type="OptionField">
                    <Required>N</Required>
                    <multiple>Y</multiple>
                    <OptionValues>
                        <ads>Advertising</ads>
                        <trackers>Trackers</trackers>
                        <malware>Malware</malware>
                        <phishing>Phishing</phishing>
                        <adult>Adult content</adult>
                        <gambling>Gambling</gambling>
                        <social>Social networks</social>
                        <streaming>Streaming media</streaming>
                        <games>Games</games>
                    </OptionValues>
                </dnsCategories>
                <dnsDomains type="CSVListField">
                    <Required>N</Required>
                    <MaskPerItem>Y</MaskPerItem>
                    <Mask>/^[a-z0-9]([a-z0-9._-]{0,251}[a-z0-9])?$/i</Mask>
                    <ValidationMessage>Enter domain names such as example.com, separated by commas.</ValidationMessage>
                </dnsDomains>
                <description type="DescriptionField"/>
            </policy>
        </policies>
    </items>
</model>
